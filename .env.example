# Valores públicos/privados usados somente na configuração local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# E-mails autorizados no painel, separados por vírgula.
ADMIN_EMAILS=
# Preferido: segredo aleatório (>=32 caracteres) injetado apenas pelo gateway
# confiável no header x-rise-admin-gateway-secret.
ADMIN_GATEWAY_SECRET=
# Alternativa legada, somente se o gateway da hospedagem remover headers externos
# e inserir os oai-authenticated-user-* autenticados: true/false.
ADMIN_TRUSTED_HEADER_AUTH=false
# Opcional: mantém uma cópia operacional sem transformar a planilha na fonte oficial.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
RATE_LIMIT_SALT=
# Supabase (Vercel production). NEXT_PUBLIC_* values are safe for the browser;
# the service-role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional public URL used for Auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:5173
