# Valores públicos/privados usados somente na configuração local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated key. Prefer the modern sb_secret_... key.
SUPABASE_SECRET_KEY=
# Legacy fallback, if your project still uses service_role.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# E-mails autorizados no painel, separados por vírgula.
ADMIN_EMAILS=
# Opcional: mantém uma cópia operacional sem transformar a planilha na fonte oficial.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
RATE_LIMIT_SALT=
# Telegram (server-only; nunca exponha o token no navegador)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Asaas (server-only; nunca exponha a chave no navegador)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
# Mercado Pago Checkout Pro (server-only)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENV=production

